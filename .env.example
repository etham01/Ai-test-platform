# SmartTest local development configuration.
# Copy to .env and adjust. Never commit .env or real secrets.

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Project-local MySQL 9.4 instance on 3307 (scripts/dev_services.sh).
# The password below is development-only and only reachable on 127.0.0.1.
DATABASE_URL=mysql+pymysql://smarttest:smarttest_dev_pw@127.0.0.1:3307/smarttest?charset=utf8mb4

# Portable Redis 8.10.3 (scripts/dev_services.sh), development-only.
REDIS_URL=redis://:smarttest_redis_dev@127.0.0.1:6379/0
# Empty values fall back to REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Set true only for unit/integration tests that do not run a worker.
CELERY_TASK_ALWAYS_EAGER=false

# Storage for DOM snapshots, screenshots, logs and reports.
STORAGE_ROOT=./storage

# Frontend dev server origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave blank in development to generate .dev/secret.key automatically.
# Production MUST set a valid Fernet key (32 url-safe base64 bytes).
SMARTTEST_SECRET_KEY=

# Exact origins allowed in development despite the SSRF private-IP block.
# This is ignored when APP_ENV=production.
SMARTTEST_DEV_ALLOWED_TARGETS=http://127.0.0.1:8001

# Execution defaults. local is NOT a security sandbox; see docs/SECURITY.md.
SMARTTEST_EXECUTION_MODE=local
SMARTTEST_ALLOW_LOCAL_EXECUTION=true

# Optional lightweight API gate. Leave blank for local single-user demo.
SMARTTEST_API_TOKEN=

# Playwright: leave blank to use bundled chromium; set to chrome/msedge as fallback.
PLAYWRIGHT_CHANNEL=
